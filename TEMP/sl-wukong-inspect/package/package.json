{
  "name": "sl-wukong-engine",
  "version": "1.0.0",
  "description": "Wukong - A powerful TypeScript Xiangqi (Chinese Chess) engine with advanced AI search algorithms",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
