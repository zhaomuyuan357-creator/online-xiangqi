    "minimax",
    "negamax",
    "board-game"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/sl-wukong-engine.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/sl-wukong-engine/issues"
  },
  "homepage": "https://github.com/yourusername/sl-wukong-engine#readme",
  "devDependencies": {
    "typescript": "^5.3.3",
    "javascript-obfuscator": "^4.1.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
